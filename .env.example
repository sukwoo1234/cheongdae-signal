NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_USER_ID=
ADMIN_REQUIRE_MFA=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production magic-link requests require a Turnstile token. Configure the matching
# secret and enable CAPTCHA protection in Supabase Auth as well.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 32자 이상의 별도 랜덤 값. Supabase service_role 키를 재사용하지 않는다.
EVENT_IDENTITY_HMAC_KEY=
